# Bancos que os agentes vão consultar — MODELO, sem valores.
#
# Copie para `.env.bancos` (que é ignorado pelo git) e preencha lá:
#
#     cp backend/.env.bancos.example backend/.env.bancos
#
# ⚠️ **Um usuário de banco por nível de acesso, sempre.** A senha preenchida vai
#    parar na tabela `integrations` do HS.OS e na config do gateway
#    (`mcp.servers.<nome>.env`, na VPS). Quem impede um agente de escrever é o
#    GRANT do Postgres — não a nossa tela, e não a instrução no prompt dele.
#
#    Para criar o usuário só-leitura (Postgres 14+):
#
#      CREATE USER hsos_agente_ro WITH PASSWORD '…';
#      GRANT CONNECT ON DATABASE <banco> TO hsos_agente_ro;
#      GRANT pg_read_all_data TO hsos_agente_ro;
#      ALTER ROLE hsos_agente_ro SET default_transaction_read_only = on;
#
#    São duas travas independentes, e vale ter as duas:
#
#    · `pg_read_all_data` é um papel embutido que dá SELECT em tudo — inclusive
#      em **tabela e schema criados depois**. É melhor que
#      `GRANT SELECT ON ALL TABLES` + `ALTER DEFAULT PRIVILEGES`, que só valem
#      para o que existe na hora e para o schema citado; com eles, tabela nova
#      fica invisível e o sintoma que chega é o agente dizendo "essa tabela não
#      existe" — parece erro de agente e é permissão.
#
#    · `default_transaction_read_only` recusa escrita **antes** de olhar
#      permissão, e pega o que GRANT nenhum cobriria (CREATE TEMP TABLE, por
#      exemplo). O erro é claro: "cannot execute … in a read-only transaction".
#
# Um bloco por banco. O prefixo antes do `_` é o identificador interno.

# ── Exemplo ──────────────────────────────────────────────────────────────────
EXEMPLO_ROTULO=Nome que aparece na tela
EXEMPLO_HOST=
EXEMPLO_PORTA=5432
EXEMPLO_BANCO=

# Usuário só-leitura
EXEMPLO_RO_USUARIO=
EXEMPLO_RO_SENHA=

# Usuário de leitura e escrita — opcional; vazio significa "este banco só lê"
EXEMPLO_RW_USUARIO=
EXEMPLO_RW_SENHA=

# `require` quando o servidor exigir SSL, `prefer` no caso comum
EXEMPLO_SSLMODE=prefer

# Agentes com acesso, separados por vírgula. Vazio = nenhum, de propósito:
# acesso a banco é concessão explícita, não padrão.
EXEMPLO_AGENTES=
