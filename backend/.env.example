# Postgres próprio (VPS 62.72.11.28)
# Use o role hsos_app, NÃO o superusuário: superuser bypassa RLS e deixaria as
# 191 policies inertes. Ver backend/migrations/002_auth_propria.sql.
# ⚠️ Formato asyncpg: postgresql:// — "postgresql+psycopg2://" é do SQLAlchemy
# e o asyncpg rejeita a URL.
DATABASE_URL=postgresql://hsos_app:senha@62.72.11.28:2222/hsos

# Auth própria — gere um segredo longo e aleatório, um por instalação:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# Origens autorizadas pelo CORS. Aceita lista separada por vírgula.
# Produção: https://hsos.healthsafetytech.com
FRONTEND_URL=http://localhost:8080

# ===== LOGIN COM MICROSOFT (Entra ID) =====
# Registro de aplicativo "HS.OS" no Entra (single tenant). Com qualquer um vazio
# o SSO fica desligado e só o login por senha funciona. Depois do login a pessoa
# volta para a PRIMEIRA origem do FRONTEND_URL.
# ⚠️ Desenvolvimento: MS_REDIRECT_URI=http://localhost:8002/auth/microsoft/callback
#    — com a URI de produção aqui, o login local termina no backend de produção.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://hsosapi.healthsafetytech.com/auth/microsoft/callback

# Uploads (substitui supabase.storage). Em produção, volume persistente.
UPLOADS_DIR=/app/uploads

# OpenClaw Gateway — o token fica SÓ aqui, nunca no frontend.
#
# Produção:      https://gateway.healthsafetytech.com
#                (o nginx de lá tem allowlist liberando 62.72.11.28, que é onde
#                 o backend roda)
# Desenvolvimento: http://127.0.0.1:18789 com túnel SSH para a VPS do OpenClaw:
#   ssh -N -o ServerAliveInterval=30 -L 18789:127.0.0.1:18789 root@2.24.85.122
#
# Estes valores também podem ser gravados em public.vps_config pela tela de
# Configurações → Gateway, que tem precedência sobre o .env.
OPENCLAW_GATEWAY_URL=
OPENCLAW_ADMIN_TOKEN=

# OpenAI — transcrição de áudio, leitura de imagem e perfil da empresa.
# Os agentes NÃO usam esta chave; eles usam o provedor do OpenClaw.
OPENAI_API_KEY=

# Segredo compartilhado com os servidores MCP que o gateway consome
# (`/mcp/alerta` e `/mcp/wiki`). O gateway o envia no header `X-Bridge-Token`;
# sem ele os dois respondem 401 e — atenção — um servidor MCP que não autentica
# simplesmente não publica ferramenta nenhuma, sem erro visível em lugar algum.
# Em produção está definido no EasyPanel, no serviço do backend.
GUARDRAILS_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Laços de fundo — todos ligados por padrão, todos batem no gateway
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ Estavam só no código até 31/08/2026. São três tarefas subindo junto com a
# API, e a única forma de saber que existiam era ler o `main.py`. `0` desliga.

# Copia o consumo das sessões para `usage_events`. Sem ele, "quanto gastamos em
# julho" não tem resposta: o gateway só guarda o estado vivo e sessão podada
# leva o histórico junto.
COLETOR_USO_SEGUNDOS=300

# Compacta a sessão antes que ela estoure e arquiva a que já travou. É o que
# cuida da `agent:<id>:main`, onde caem as mensagens entre agentes e por onde
# ninguém olha.
VIGIA_SESSOES_SEGUNDOS=600

# Enche as quatro tabelas de `/monitoring` (gateway_health, usage_daily,
# agent_stats, cron_jobs). Existe desde 31/08 porque o coletor que rodava na
# VPS sumiu na migração e as telas ficaram vazias desde sempre.
COLETOR_METRICAS_SEGUNDOS=300

# ─────────────────────────────────────────────────────────────────────────────
# Segredos compartilhados das integrações
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ **Falta de segredo = 503, não porta aberta.** O `exige_segredo` recusa
# quando o valor não existe — o contrário transformaria esquecimento de config
# em porta aberta. Conferido em 31/08/2026 na produção: destes, só o
# GUARDRAILS_API_TOKEN está definido; os outros respondem 503 a qualquer
# chamada, o que na prática significa endpoint desligado.
#
# O valor pode vir daqui OU da tabela `integration_secrets`, que tem
# precedência e é editável pela tela de Integrações.

# Webhook pelo qual o agente empurra a resposta pronta (`/conversations/webhook/resposta`).
AGENT_REPLY_WEBHOOK_SECRET=

# Webhook que dispara automações a partir de evento externo.
AUTOMATION_WEBHOOK_SECRET=

# Ponte de dados dos artefatos vivos (`window.hsos`).
BRIDGE_API_TOKEN=

# API externa de envio de mensagem a canais e DMs.
BROADCAST_API_KEY=

# Coletor de métricas que empurra para `/coletor/estatisticas`.
# ⚠️ Hoje ninguém empurra: o coletor da VPS não existe mais, e quem enche essas
# tabelas é o COLETOR_METRICAS_SEGUNDOS acima. Este segue de pé para quem quiser
# alimentar de fora.
COLLECTOR_API_TOKEN=

# Ingestão de dado externo.
INGEST_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Ajustes menores
# ─────────────────────────────────────────────────────────────────────────────
# Dias sem toque para um card contar como "parado" no relatório de vendedores.
# ⚠️ A régua manda em ~/projetos/relatorios-hsgrowth — mudar só aqui faz o
# número do agente divergir do número do Erick, em silêncio.
DIAS_PARADO=7

# Onde as skills são publicadas no gateway. Padrão do `publicar-skills.sh`.
SKILLS_DIR=/root/.openclaw/skills

# Cloudflare R2 — storage de todos os arquivos (ver docs/DEPLOY.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hsos-arquivos

# Segredo do HMAC das entradas `hsos-anexos-<agente>` no gateway: a URL de cada
# uma leva HMAC(ANEXOS_MCP_SEGREDO, id do agente), e é isso que diz ao backend
# QUEM chama `ler_anexo`/`enviar_arquivo`. Sem ele as rotas /mcp/anexos recusam.
# Gerar:  python -c "import secrets; print(secrets.token_hex(32))"
# Onde gravar: de preferência em `public.integration_secrets` (name =
# 'ANEXOS_MCP_SEGREDO'), que o `ler_segredo` consulta antes do ambiente; ou aqui.
# ⚠️ Trocar o valor invalida as URLs já declaradas no gateway — rode de novo o
# `scripts/publicar-anexos-mcp.py` com o valor novo.
ANEXOS_MCP_SEGREDO=

# Busca de GIF do chat (`GET /gifs`). A chave fica aqui, não no front: até
# 15/10/2026 ela era VITE_* e o build de produção nunca a recebia.
GIPHY_API_KEY=

# EscritorioHS (WorkAdventure) — Admin API (`/escritorio-wa/api/*`) e presença
# (`/escritorio/presenca`). Os dois tokens são os MESMOS valores das variáveis
# ADMIN_API_TOKEN e ADMIN_SOCKETS_TOKEN do serviço `play` do WA. Gerar:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Sem o primeiro, a Admin API responde 503; sem o segundo, a presença fica
# desligada e `/escritorio/presenca` responde `conectado: false`.
ESCRITORIO_ADMIN_API_TOKEN=
ESCRITORIO_ADMIN_SOCKETS_TOKEN=
# E-mails por vírgula: quem edita o mapa (substitui o MAP_EDITOR_ALLOWED_USERS).
ESCRITORIO_EDITORES=
# Domínios por vírgula: quem entra no escritório.
ESCRITORIO_DOMINIOS=healthsafetytech.com
ESCRITORIO_URL=https://escritoriohs.healthsafetytech.com
ESCRITORIO_MAP_STORAGE_URL=https://escritoriohs.healthsafetytech.com/map-storage
# Para onde a raiz do escritório redireciona (substitui o START_ROOM_URL).
ESCRITORIO_SALA_INICIAL=/~/hs/hs.wam
