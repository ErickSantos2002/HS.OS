# Postgres próprio (VPS)
DATABASE_URL=postgresql://usuario:senha@host:5432/hsos

# Auth própria — gere um segredo longo e aleatório, um por instalação
JWT_SECRET=troque-por-um-segredo-forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

FRONTEND_URL=http://localhost:8080

# Uploads (substitui supabase.storage). Em produção use volume persistente.
UPLOADS_DIR=/app/uploads

# OpenClaw Gateway — o token fica SÓ aqui, nunca no frontend
OPENCLAW_GATEWAY_URL=
OPENCLAW_ADMIN_TOKEN=
