# Postgres próprio (VPS 62.72.11.28)
# Use o role hsos_app, NÃO o superusuário: superuser bypassa RLS e deixaria as
# 191 policies inertes. Ver backend/migrations/002_auth_propria.sql.
# ⚠️ Formato asyncpg: postgresql:// — "postgresql+psycopg2://" é do SQLAlchemy
# e o asyncpg rejeita a URL.
DATABASE_URL=postgresql://hsos_app:senha@62.72.11.28:2222/hsos

# Auth própria — gere um segredo longo e aleatório, um por instalação:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Origens autorizadas pelo CORS. Aceita lista separada por vírgula.
# Produção: https://hsos.healthsafetytech.com
FRONTEND_URL=http://localhost:8080

# Uploads (substitui supabase.storage). Em produção, volume persistente.
UPLOADS_DIR=/app/uploads

# OpenClaw Gateway — o token fica SÓ aqui, nunca no frontend.
#
# Produção:      https://gateway.healthsafetytech.com
#                (o nginx de lá tem allowlist liberando 62.72.11.28, que é onde
#                 o backend roda)
# Desenvolvimento: http://127.0.0.1:18789 com túnel SSH para a VPS do OpenClaw:
#   ssh -N -o ServerAliveInterval=30 -L 18789:127.0.0.1:18789 root@2.24.85.122
#
# Estes valores também podem ser gravados em public.vps_config pela tela de
# Configurações → Gateway, que tem precedência sobre o .env.
OPENCLAW_GATEWAY_URL=
OPENCLAW_ADMIN_TOKEN=

# OpenAI — transcrição de áudio, leitura de imagem e perfil da empresa.
# Os agentes NÃO usam esta chave; eles usam o provedor do OpenClaw.
OPENAI_API_KEY=

# Segredo compartilhado com os servidores MCP que o gateway consome
# (`/mcp/alerta` e `/mcp/wiki`). O gateway o envia no header `X-Bridge-Token`;
# sem ele os dois respondem 401 e — atenção — um servidor MCP que não autentica
# simplesmente não publica ferramenta nenhuma, sem erro visível em lugar algum.
# Em produção está definido no EasyPanel, no serviço do backend.
GUARDRAILS_API_TOKEN=
