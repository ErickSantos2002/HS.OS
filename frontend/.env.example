# Backend próprio. Em Docker o nginx repassa /api para o backend (mesma origem).
# Em dev local aponte direto para o uvicorn: http://localhost:8000
VITE_API_URL=/api

# --- Supabase (LEGADO — em remoção) ---
# Ainda necessário enquanto o front não for portado para a API própria:
# 113 arquivos de src/ importam o client do Supabase.
# Apagar estas quatro quando a portagem terminar.
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

VITE_GIPHY_API_KEY=
