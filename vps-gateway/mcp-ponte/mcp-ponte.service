[Unit]
Description=mcp-ponte — MCP hsos-* no loopback do gateway OpenClaw (cache de handshake)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/mcp-ponte/server.mjs
WorkingDirectory=/opt/mcp-ponte
Environment=NODE_ENV=production
Environment=MCP_PONTE_HOST=127.0.0.1
Environment=MCP_PONTE_PORTA=18791
Environment=MCP_PONTE_ORIGEM=https://hsosapi.healthsafetytech.com
Restart=always
RestartSec=2

# Não guarda credencial nem lê disco: o token chega em cada pedido.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
