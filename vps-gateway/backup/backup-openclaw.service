[Unit]
Description=Backup cifrado do OpenClaw para o R2 (PK-10)
# Sem credencial, não roda — e não dá erro: o timer pode estar ligado antes.
ConditionPathExists=/root/.config/backup-openclaw/env
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/backup-openclaw/backup-openclaw.sh
# O systemd não define $HOME, e sem ele o restic roda SEM cache: a cada noite
# baixava o índice do R2 de novo (operação paga — a conta já passa da faixa
# grátis). É o mesmo cache que o `--testar` pelo ssh já usa.
Environment=RESTIC_CACHE_DIR=/root/.cache/restic
Nice=10
IOSchedulingClass=idle
# Não disputa memória com o gateway: a VPS já conheceu OOM (PK-47).
MemoryMax=1G
