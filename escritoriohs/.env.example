# Variáveis do serviço Compose `escritoriohs` no EasyPanel.
# ⚠️ Repo público: segredo NUNCA aqui. Os valores vão para a aba Environment
# do EasyPanel, gerados por `openssl rand -hex 32` (ver README, "Segredos").

VERSION=v1.33.11
DOMAIN=escritoriohs.healthsafetytech.com

# Login — app "EscritorioHS" no Entra (ver README, "Entra")
DISABLE_ANONYMOUS=true
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_CLIENT_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
OPENID_SCOPE=openid email profile
OPENID_USERNAME_CLAIM=name
OPENID_WOKA_NAME_POLICY=force_opid
OPENID_LOGOUT_REDIRECT_URL=https://escritoriohs.healthsafetytech.com/
FALLBACK_LOCALE=pt-BR
ENABLE_TUTORIAL=true

# Editor de mapa — só a lista. ⚠️ Ignorada quando houver ADMIN_API (sub-projeto B).
MAP_EDITOR_ALLOW_ALL_USERS=false
MAP_EDITOR_ALLOWED_USERS=

# Admin API do HS.OS (sub-projeto B) — só o `play` as recebe. Vazia = o WA
# decide sozinho (LocalAdmin). Na implantação:
#   ADMIN_API_URL=https://hsosapi.healthsafetytech.com/escritorio-wa
# Os dois tokens são os mesmos valores de ESCRITORIO_ADMIN_API_TOKEN e
# ESCRITORIO_ADMIN_SOCKETS_TOKEN no backend do HS.OS (`openssl rand -hex 32`).
# ⚠️ Com ADMIN_API_URL preenchida, MAP_EDITOR_ALLOWED_USERS e START_ROOM_URL
# ficam sem efeito (quem decide é ESCRITORIO_EDITORES / ESCRITORIO_SALA_INICIAL
# no HS.OS). Volta atrás: esvaziar ADMIN_API_URL e reimplantar.
ADMIN_API_URL=
ADMIN_API_TOKEN=
ADMIN_SOCKETS_TOKEN=

# Chat: sem Matrix. O chat da bolha depende disto (conferir na Task 5).
ENABLE_CHAT=true

# Sala de entrada (preenchida na Task 6)
START_ROOM_URL=/~/hs/hs.wam

# Segredos internos do WA
SECRET_KEY=
MAP_STORAGE_API_TOKEN=
MAP_STORAGE_AUTHENTICATION_TOKEN=
ROOM_API_SECRET_KEY=

# Vídeo
MAX_USERS_FOR_WEBRTC=4
LIVEKIT_HOST=wss://livekit.healthsafetytech.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STUN_SERVER=stun:62.72.11.28:3478
# Os dois transportes: sem ?transport= o navegador aloca só por UDP, e quem está
# em rede sem UDP fica sem vídeo nas bolhas de até 4.
TURN_SERVER=turn:62.72.11.28:3478?transport=udp,turn:62.72.11.28:3478?transport=tcp
TURN_STATIC_AUTH_SECRET=

SECURITY_EMAIL=
